# EvoTailor configuration. Copy to .env and fill in for your environment.
# No credentials, personal host names, or personal filesystem paths are bundled.

# --- data and artifacts -------------------------------------------------------
EVOTAILOR_DATA_ROOT=/data/evotailor
EVOTAILOR_MODEL_ROOT=/models
EVOTAILOR_TASK_ROOT=/tasks
EVOTAILOR_RUNS_ROOT=./runs

# --- serving engine -----------------------------------------------------------
# Either a python interpreter that provides the engine, or the engine binary.
PYTHON=python3
EVOTAILOR_VLLM_BIN=vllm
EVOTAILOR_SGLANG_BIN=python3
EVOTAILOR_SERVED_MODEL_PATH=/models/Qwen3-4B
EVOTAILOR_SERVED_MODEL_NAME=Qwen3-4B

# --- search-decision agent ----------------------------------------------------
# Model used to propose candidates and to reflect between stages. This is distinct
# from the model that serves application requests.
EVOTAILOR_V2_MODEL=<proposer-model-id>
EVOTAILOR_V2_BASE_URL=<openai-compatible-endpoint>
EVOTAILOR_PROPOSER_API_KEY=<api-key>

# --- prediction backend (AIConfigurator) --------------------------------------
EVOTAILOR_AIC_PROFILE=configs/aiconfigurator_profile.example.json
EVOTAILOR_TOKENIZER_PYTHON=python3

# --- runtime config -----------------------------------------------------------
EVOTAILOR_RUNTIME_CONFIG=configs/runtime.yaml

# --- external baseline installation -----------------------------------------
EVOTAILOR_MATURE_ROOT=/path/to/upstream-optimizer-installation
EVOTAILOR_BASELINE_PYTHON=python3
# Optional model endpoint failover; leave empty when unused.
EVOTAILOR_FALLBACK_BASE_URL=
